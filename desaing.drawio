        <mxCell id="step2" value="&lt;b style='font-size: 15px;'&gt;Search for Jobs&lt;/b&gt;&lt;br&gt;Filters by title, location, type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;shadow=1;strokeWidth=2;arcSize=10;padding=10;" parent="f1" vertex="1">
          <mxGeometry x="480" y="390" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step3" value="&lt;b style='font-size: 15px;'&gt;Submit Application&lt;/b&gt;&lt;br&gt;Attach CV &amp; Cover Letter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;shadow=1;strokeWidth=2;arcSize=10;padding=10;" parent="f1" vertex="1">
          <mxGeometry x="480" y="520" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step4" value="&lt;b style='font-size: 15px;'&gt;Company Review&lt;/b&gt;&lt;br&gt;Employer reviews the application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;fontColor=#78350f;shadow=1;strokeWidth=2;arcSize=10;padding=10;" parent="f1" vertex="1">
          <mxGeometry x="480" y="650" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="decision" value="&lt;b style='font-size: 16px;'&gt;Decision?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;shadow=1;strokeWidth=2;" parent="f1" vertex="1">
          <mxGeometry x="520" y="780" width="160" height="120" as="geometry" />
        </mxCell>

        <mxCell id="accept" value="&lt;b style='font-size: 15px;'&gt;Accepted&lt;/b&gt;&lt;br&gt;Notify Jobseeker (Success)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#064e3b;shadow=1;strokeWidth=2;arcSize=10;padding=10;" parent="f1" vertex="1">
