  <diagram id="flowchart_diagram" name="3. Flowchart">
    <mxGraphModel dx="1000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1400" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="f0" />
