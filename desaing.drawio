        <mxCell id="step1" value="&lt;b style='font-size: 15px;'&gt;Jobseeker Registers&lt;/b&gt;&lt;br&gt;Creates account &amp; builds profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;shadow=1;strokeWidth=2;arcSize=10;padding=10;" parent="f1" vertex="1">
