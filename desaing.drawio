  <diagram id="erd_diagram" name="1. ERD (Entity Relationship Diagram)">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" background="#f8fafc" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Header -->
        <mxCell id="erd_title" value="&lt;b style='font-size: 28px;'&gt;Fursad Job Portal - ERD&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 14px; color: #64748b;'&gt;Database Architecture &amp; Relationships&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Inter, Helvetica;fontColor=#0f172a;" parent="1" vertex="1">
          <mxGeometry x="400" y="40" width="400" height="80" as="geometry" />
        </mxCell>

        <!-- Company_DB -->
        <mxCell id="company" value="&lt;b style='font-size: 16px;'&gt;Company_DB&lt;/b&gt;&lt;hr&gt;&lt;div style='text-align: left; font-size: 13px;'&gt;PK: id&lt;br&gt;c_name (String)&lt;br&gt;c_email (String, Unique)&lt;br&gt;c_phone (String)&lt;br&gt;c_username (String)&lt;br&gt;c_password (String)&lt;br&gt;c_active (Boolean)&lt;br&gt;c_logo (File)&lt;br&gt;c_location (String)&lt;br&gt;c_joined (DateTime)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;shadow=1;glass=0;sketch=0;verticalAlign=top;padding=15;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="150" y="150" width="260" height="280" as="geometry" />
        </mxCell>

        <!-- jops_DB -->
        <mxCell id="job" value="&lt;b style='font-size: 16px;'&gt;jops_DB (Jobs)&lt;/b&gt;&lt;hr&gt;&lt;div style='text-align: left; font-size: 13px;'&gt;PK: id&lt;br&gt;FK: j_company_id (Company)&lt;br&gt;j_title (String)&lt;br&gt;j_description (Text)&lt;br&gt;j_location (String)&lt;br&gt;j_salary (String)&lt;br&gt;j_jobtype (String)&lt;br&gt;j_active (Boolean)&lt;br&gt;j_posted (DateTime)&lt;br&gt;j_EXP (Date)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#064e3b;shadow=1;glass=0;sketch=0;verticalAlign=top;padding=15;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="750" y="150" width="260" height="280" as="geometry" />
        </mxCell>

        <!-- shaqod_DB -->
        <mxCell id="shaqodon" value="&lt;b style='font-size: 16px;'&gt;shaqod_DB (Jobseeker)&lt;/b&gt;&lt;hr&gt;&lt;div style='text-align: left; font-size: 13px;'&gt;PK: id&lt;br&gt;s_fullname (String)&lt;br&gt;s_email (String, Unique)&lt;br&gt;s_phone (String)&lt;br&gt;s_username (String)&lt;br&gt;s_password (String)&lt;br&gt;s_cv (File)&lt;br&gt;s_skills (Text)&lt;br&gt;s_experience (Text)&lt;br&gt;s_status (Boolean)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;fontColor=#7f1d1d;shadow=1;glass=0;sketch=0;verticalAlign=top;padding=15;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="150" y="550" width="260" height="280" as="geometry" />
        </mxCell>

        <!-- Application_DB -->
        <mxCell id="application" value="&lt;b style='font-size: 16px;'&gt;Application_DB&lt;/b&gt;&lt;hr&gt;&lt;div style='text-align: left; font-size: 13px;'&gt;PK: id&lt;br&gt;FK: a_job_id (Job)&lt;br&gt;FK: a_shaqod_id (Jobseeker)&lt;br&gt;a_cover_letter (Text)&lt;br&gt;a_cv (File)&lt;br&gt;a_applied_date (DateTime)&lt;br&gt;a_status (Enum: pending, accepted...)&lt;br&gt;a_deleted_by_company (Boolean)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;fontColor=#78350f;shadow=1;glass=0;sketch=0;verticalAlign=top;padding=15;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="750" y="550" width="260" height="280" as="geometry" />
        </mxCell>

        <!-- Relationships -->
        <mxCell id="rel1" edge="1" parent="1" source="company" target="job">
          <mxGeometry relative="1" as="geometry" />
          <mxCell value="1 : N (Posts)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#3b82f6;fontStyle=1" vertex="1" connectable="0" parent="rel1">
            <mxGeometry x="0.05" y="1" relative="1" as="geometry">
              <mxPoint x="-5" y="-11" as="offset" />
            </mxGeometry>
          </mxCell>
        </mxCell>

        <mxCell id="rel2" edge="1" parent="1" source="job" target="application">
          <mxGeometry relative="1" as="geometry" />
          <mxCell value="1 : N (Receives)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#10b981;fontStyle=1" vertex="1" connectable="0" parent="rel2">
            <mxGeometry x="-0.1" y="2" relative="1" as="geometry">
              <mxPoint x="28" y="10" as="offset" />
            </mxGeometry>
          </mxCell>
        </mxCell>

        <mxCell id="rel3" edge="1" parent="1" source="shaqodon" target="application">
          <mxGeometry relative="1" as="geometry" />
          <mxCell value="1 : N (Submits)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#ef4444;fontStyle=1" vertex="1" connectable="0" parent="rel3">
            <mxGeometry x="-0.1" y="-3" relative="1" as="geometry">
              <mxPoint x="15" y="-13" as="offset" />
            </mxGeometry>
          </mxCell>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="context_diagram" name="2. Context Diagram">
